# Backend config (read by backend/settings.py via environment variables)

# Required for encrypting RouterOS passwords stored in DB.
# Change this in real deployments.
SECRET_KEY=change-me

# Use the docker volume DB by default (recommended when running with docker-compose).
DATABASE_URL=sqlite:////data/wgmik.db

# Debug mode (FastAPI debug + logs)
DEBUG=false

# First-run admin bootstrap
# If INITIAL_ADMIN_PASSWORD is empty, a random password will be generated and printed
# to the API container logs once (only when the DB has no users yet).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

