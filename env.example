# Optional overrides for wgmik-server.
#
# A fresh install needs NO .env file at all: just `docker compose pull && docker compose up -d`.
# The admin account is created in the browser on first run, and SECRET_KEY is
# auto-generated and persisted. Copy this file to .env only if you want to
# override a default below.

# Which prebuilt image tag to run (e.g. latest, v1.0.0). Defaults to latest.
# WGMIK_TAG=latest

# Encrypts RouterOS passwords / WG keys / Telegram token and signs JWTs.
# Leave unset to auto-generate and persist to /data/secret_key on first run.
# Set a fixed value only for advanced/multi-instance deployments.
# SECRET_KEY=

# Where the SQLite DB lives (defaults to the docker /data volume).
# DATABASE_URL=sqlite:////data/wgmik.db

# FastAPI debug + verbose logs.
# DEBUG=false
